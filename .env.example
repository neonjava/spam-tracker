# ============================================
# Spam Tracker - Environment Variables
# ============================================

# Discord Bot Configuration (Required)
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# Database Connection
# SQLite (development):
DATABASE_URL="file:./dev.db"
# PostgreSQL (production):
# DATABASE_URL="postgresql://user:password@localhost:5432/other_side_guardian"

# Web Admin Dashboard Configuration
DASHBOARD_PORT=3001
ADMIN_PASSWORD=replace_with_a_unique_long_password

# Voting Links (Optional - only shown if configured)
TOPGG_VOTE_URL=
DISCORDBOTLIST_VOTE_URL=
BOTSERVICES_VOTE_URL=
